{
  "name": "confession-attendance-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A private, date-only confession attendance tracking system.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:db && vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "invite:new": "tsx scripts/create-invite.ts",
    "db:studio": "prisma studio",
    "smoke": "node scripts/smoke-test.mjs",
    "check:arabic": "node scripts/check-arabic-strings.mjs",
    "check:secrets": "node scripts/audit-secrets.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:arabic && npm run check:secrets && npm run test && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "6.12.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "dotenv": "18.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prisma": "6.12.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
