# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection used by the running application.
# The role MUST NOT be a superuser and MUST NOT have the BYPASSRLS attribute,
# otherwise Row-Level Security is silently disabled and tenant isolation is
# enforced by application code alone. If the role happens to own the tables,
# the policies also need FORCE ROW LEVEL SECURITY (see the RLS migration).
DATABASE_URL="postgresql://app_user:CHANGE_ME@127.0.0.1:5432/confession?schema=public"

# Connection used only by `prisma migrate`. Use a role that owns the schema.
DIRECT_DATABASE_URL="postgresql://migration_user:CHANGE_ME@127.0.0.1:5432/confession?schema=public"

# ---------------------------------------------------------------------------
# Test database
# ---------------------------------------------------------------------------
# A separate database from development; the test suite deletes every row it
# creates. TEST_DATABASE_URL must use the restricted application role, never a
# superuser: a superuser bypasses Row-Level Security, so the tenant-isolation
# tests would pass without the database enforcing anything.
# TEST_DATABASE_URL="postgresql://app_user:CHANGE_ME@127.0.0.1:5432/confession_test?schema=public"
# TEST_DIRECT_DATABASE_URL="postgresql://migration_user:CHANGE_ME@127.0.0.1:5432/confession_test?schema=public"

# ---------------------------------------------------------------------------
# First platform administrator (bootstrap only)
# ---------------------------------------------------------------------------
# Used solely by `npm run db:seed` to bootstrap the very first tenant and its
# administrator. Every later priest is onboarded with `npm run invite:new`
# instead. The password must be at least 12 characters. Remove these from the
# environment once the account exists.
# ADMIN_NAME=""
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# Optional. Defaults to "<name>'s parish".
# TENANT_NAME=""

# ---------------------------------------------------------------------------
# Password reset email
# ---------------------------------------------------------------------------
# Required for the "forgot password" flow in production.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Confession Attendance <no-reply@example.com>"
# SMTP_SECURE="false"
# APP_URL="https://example.com"
